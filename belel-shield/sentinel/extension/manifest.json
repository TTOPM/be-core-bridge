{
  "manifest_version": 3,
  "name": "Belel Sentinel",
  "version": "0.1.0",
  "action": { "default_title": "Belel Sentinel" },
  "permissions": ["declarativeNetRequest", "declarativeNetRequestWithHostAccess", "storage"],
  "host_permissions": ["<all_urls>"],
  "declarative_net_request": {
    "rule_resources": [{
      "id": "base_rules",
      "enabled": true,
      "path": "rules/base_rules.json"
    }]
  }
}
