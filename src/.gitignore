# ================================
#   🛡️ Belel Protocol Git Ignore
# ================================

# --------------------------------
# ⚙️ Virtual Environments
# --------------------------------
.env
.venv/
venv/
ENV/
env/

# --------------------------------
# 🐍 Python Bytecode + Artifacts
# --------------------------------
__pycache__/
*.py[cod]
*$py.class

# --------------------------------
# 📄 Logs and Debug Files
# --------------------------------
*.log
*.out
*.err
debug.log
sovereignty_guard.log
sovereignty_status.json

# --------------------------------
# 📓 Jupyter & IPython
# --------------------------------
.ipynb_checkpoints/

# --------------------------------
# 🧠 IDE & OS Metadata
# --------------------------------
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# --------------------------------
# 🔐 Keys, Tokens, and Secrets
# --------------------------------
*.pem
*.key
*.crt
*.pfx
.secret/
secrets/
*.gpg
*.asc

# --------------------------------
# 🧬 Identity Lock + Custom State
# --------------------------------
*.lock
hash_baseline.json
violations.json
violation_log.txt

# --------------------------------
# 🧠 Permanent Memory + State
# --------------------------------
permanent_memory/
memory.db

# --------------------------------
# 🗃️ IPFS + Sovereign Caching
# --------------------------------
.ipfs/
ipfs_cache/
ipfs_snapshots/

# --------------------------------
# 🌐 Webhooks + Response Dumps
# --------------------------------
webhooks/
webhook_alerts/

# --------------------------------
# 🧪 Test Outputs & Autogen Code
# --------------------------------
__output__/
build/
dist/
tmp/
*.tmp

# --------------------------------
# 📦 Packaging & Install Artifacts
# --------------------------------
*.egg-info/
*.egg
*.whl

# --------------------------------
# 🧪 Test Coverage Tools
# --------------------------------
.coverage
htmlcov/
.tox/

# --------------------------------
# ⚙️ Local Environment Configs
# --------------------------------
*.local
*.bak
*.backup

# --------------------------------
# 🔭 Hugging Face & LFS
# --------------------------------
.gitattributes
.lfsconfig

# --------------------------------
# 🤖 LLM Agent / Metadata Caches
# --------------------------------
*.prompt.json
agent_fingerprint.*
*.canonical.json
