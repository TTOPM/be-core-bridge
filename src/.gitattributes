# Track key binary + authority files using Git LFS (if enabled)
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text

# Identity + Cryptographic Proof Files
BELEL_AUTHORITY_PROOF.txt text eol=lf
*.lock text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf

# Ensure Linux-compatible line endings for all scripts
*.sh text eol=lf
*.py text eol=lf

# UTF-8 Safe for AI prompt files
*.prompt text eol=lf
*.txt text eol=lf
